# Токен авторизації з браузера (значення куки authorization з edu.genius.space)
GENIUS_AUTH_TOKEN=your_token_here

# Опціонально: Session-Id з заголовків або кук (якщо потрібно)
GENIUS_SESSION_ID=

# Slug курсу за замовчуванням
DEFAULT_COURSE_SLUG=nocodedeveloper

# Папка для цього курсу (вже створена в Education)
DEFAULT_COURSE_DIR=GeniusSpace_No-Code Developer

# Базова папка для збереження (. означає поточну папку Education)
DOWNLOAD_BASE_DIR=.

# Завантажувати відео (true/false)
DOWNLOAD_VIDEOS=true

# Завантажувати додаткові файли/презентації (true/false)
DOWNLOAD_FILES=true

# Якість відео (best, 1080p, 720p, 480p, 360p)
VIDEO_QUALITY=720p

# Авто-стиснення та оптимізація відео під час завантаження (false = максимальна швидкість завантаження)
OPTIMIZE_VIDEOS=false
OPTIMIZE_CRF=26
